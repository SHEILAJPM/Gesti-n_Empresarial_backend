# backend/.env se genera solo desde la raíz del proyecto (ya vinculado a Neon con `neon link`):
#   neon env pull --file backend/.env -s postgres
# No se sube a git. Formato de lo que escribe Neon:
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://USUARIO:CLAVE@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
NEON_BRANCH=production

# Contraseñas de los usuarios que se crean la primera vez que arranca el sistema (admin, rrhh1, contabilidad1,
# administracion1). Si una falta, ese usuario no se crea. Usa claves propias: este archivo de ejemplo es público.
ADMIN_PASSWORD=
RRHH_PASSWORD=
CONTABILIDAD_PASSWORD=
ADMINISTRACION_PASSWORD=

# Facturación electrónica con APISUNAT (opcional). Sin estas líneas se usa el simulador local de SUNAT.
# En apisunat.com > Configuración de Empresa > API REST: copia el personaId y un personaToken del ambiente DESARROLLO.
APISUNAT_PERSONA_ID=
APISUNAT_PERSONA_TOKEN=
# Datos de la empresa emisora tal como está registrada en APISUNAT
EMISOR_RUC=20000000001
EMISOR_RAZON_SOCIAL=PRINCIPE S.A.C.

# Autocompletar nombre por DNI (RENIEC) y razón social por RUC (SUNAT). Crea el token en https://decolecta.com/profile
DECOLECTA_TOKEN=
